# Fichiers générés et locaux — jamais versionnés.
# Conforme à la section 9.3 du prompt maître (contenu des archives).

# Gradle
.gradle/
build/
**/build/
local.properties
captures/
.kotlin/

# IDE
.idea/
*.iml
.vscode/

# Natif
.cxx/

# Signatures — les clés RELEASE ne vivent jamais dans le dépôt ni dans les
# archives (AGENTS.md règle 7). Exception ADR 0067 : l'identité debug
# PUBLIQUE (identifiants connus android/androiddebugkey, patrons
# AOSP/CodeAssist) est versionnée — le runner GitHub n'a aucun
# ~/.android/debug.keystore stable et les caches actions/cache sont scopés
# par ref et évictables : sans clé commune, chaque APK CI portait une
# signature différente (« conflit de package » à chaque mise à jour).
*.keystore
*.jks
!config/signature/debug.keystore
config/signature/keystore.properties
!gradle/wrapper/gradle-wrapper.jar

# Système
.DS_Store
Thumbs.db

# Livrables
dist/

# Tooling Gradle (G2, §4.7 du prompt Tooling) : le JAR orchestrateur des
# assets est un ARTEFACT DE BUILD régénéré par :tooling:server:copierJarVersAssets
# (branché sur preBuild de l'app) — jamais une source versionnée.
app/src/main/assets/tooling/
